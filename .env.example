# Public API base URL; keep API endpoints same-origin where possible.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Comma-separated exact origins allowed to call /api routes cross-origin.
RESOGUARD_ALLOWED_ORIGINS=http://localhost:3000

# Use a public STUN server for development; replace for production as needed.
NEXT_PUBLIC_WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# Smart-contract address used by the client/server integration.
ZKP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Vercel supplies OIDC credentials automatically in supported runtimes.
# Do not manually create or commit an OIDC token.
VERCEL_OIDC_TOKEN=
